// Prisma schema for BookRalf
// Using Postgres (e.g. Supabase) — see README section 1 for setup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Location {
  id          String        @id @default(cuid())
  name        String        @unique
  description String        @default("")
  order       Int           @default(0)
  scheduleDays ScheduleDay[]
  bookings    Booking[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  price       Float
  durationMin Int
  active      Boolean  @default(true)
  order       Int      @default(0)
  // Haircut, Child, and Haircut+Beard share a bulk-time discount when
  // several are booked together (no travel time between them since it's
  // one visit). Ceremonial Haircut and anything else stays at full price
  // in time regardless of how many are booked. See lib/bucketDuration.js.
  isBulkHaircut Boolean @default(false)
  items       BookingServiceItem[]
}

// The bulk-haircut discount table itself — editable from the staff Edit
// Services page. Counts of 1-2 always use the actual sum of the chosen
// items' own durations (handled in code, not a row here, since it isn't
// a flat value). A count landing in one of these ranges uses flatMinutes
// instead, regardless of which bulk-eligible services make it up.
model BulkHaircutBracket {
  id          String @id @default(cuid())
  minCount    Int
  maxCount    Int
  flatMinutes Int
  order       Int    @default(0)
}

model ScheduleDay {
  id         String    @id @default(cuid())
  locationId String
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  date       String    // "YYYY-MM-DD"
  startTime  String    // "09:00" 24h
  endTime    String    // "17:00" 24h
  bookings   Booking[]
  createdAt  DateTime  @default(now())

  @@index([date])
  @@index([locationId, date])
}

model Booking {
  id               String    @id @default(cuid())
  customerName     String
  phone            String
  email            String
  address          String
  locationId       String
  location         Location  @relation(fields: [locationId], references: [id])
  scheduleDayId    String?
  scheduleDay      ScheduleDay? @relation(fields: [scheduleDayId], references: [id], onDelete: SetNull)
  date             String    // "YYYY-MM-DD"
  startTime        String    // "12:30"
  endTime          String    // "14:00"
  totalPrice       Float
  totalDurationMin Int
  totalSlots       Int
  status           String    @default("pending") // pending | confirmed | declined | cancelled | completed
  cancelledBy      String?   // "client" | "staff" — who cancelled; null on older rows = staff
  reminderSentAt   DateTime? // set once the day-of reminder has gone out — prevents double-sends
  invoiceNumber    String?   // e.g. "INV-2026-0042" — assigned once, on first send, then reused on resend
  invoicedAt       DateTime? // when the invoice was first sent
  invoicePaid      Boolean   @default(false) // staff-toggled, purely informational — no payment processing involved
  items            BookingServiceItem[]
  notifications    Notification[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([scheduleDayId])
  @@index([status])
}

model BookingServiceItem {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])
  quantity  Int     @default(1)
  // snapshot of price/duration at time of booking, so later service edits
  // don't retroactively change historical bookings
  unitPrice   Float
  unitMinutes Int
}

model Notification {
  id        String   @id @default(cuid())
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  audience  String   // "customer" | "admin"
  type      String   // requested | confirmed | declined | cancelled
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([audience, read])
}

// ---------------------------------------------------------------------------
// About page content — all of it editable from the staff "Site Content" page.
// ---------------------------------------------------------------------------

// One row only (id is always "main"): the "About Ralf" intro text and the
// optional photo. The photo is stored right here (a small, already-resized
// JPEG) because Vercel's filesystem is read-only at runtime. photo = null
// means "no photo" and the About page simply shows text.
model AboutContent {
  id           String   @id @default("main")
  heading      String   @default("About Ralf")
  intro        String   @default("")
  photo        Bytes?
  photoMime    String?
  updatedAt    DateTime @updatedAt
}

// "How it works" steps, shown in order.
model ProcessStep {
  id          String  @id @default(cuid())
  title       String
  description String  @default("")
  order       Int     @default(0)
  active      Boolean @default(true)
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String  @default("")
  order    Int     @default(0)
  active   Boolean @default(true) // false = hidden from the public page
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  postedOn  String   // "YYYY-MM-DD" — the date shown on the post (editable)
  published Boolean  @default(true)
  pinned    Boolean  @default(false)
  showUntil String?  // "YYYY-MM-DD" — optional; hidden after this date
  createdAt DateTime @default(now())

  @@index([published, pinned])
}
